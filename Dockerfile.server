FROM node:24-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS web-builder
WORKDIR /src/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY api/openapi.yaml /src/api/openapi.yaml
# The build ships the documents the interface links to next to the bundle. The
# bundle reads each one from the repository root while it builds, so each one
# needs its own copy here.
COPY README.md /src/README.md
COPY docs/LIMITS.md /src/docs/LIMITS.md
COPY docs/api.md /src/docs/api.md
COPY web/ ./
RUN pnpm build

FROM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS builder
ARG VERSION=dev
WORKDIR /src
COPY . .
COPY --from=web-builder /src/internal/webui/dist /src/internal/webui/dist
RUN make build VERSION="$VERSION"
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
ARG VERSION=dev
# image.source must be the repository that actually hosts this code.
# The product is named pglens and the Go module path says so, but the
# GitHub repository is manprint/gitlens; ghcr.io links a package to its
# repository through this label, and a URL that 404s breaks that link.
LABEL org.opencontainers.image.title="pglens-server" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.source="https://github.com/manprint/gitlens" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.description="pglens server: ingest, HTTP API, and web interface"
COPY --from=builder /src/bin/pglens-server /usr/local/bin/pglens-server
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["/usr/local/bin/pglens-server", "--healthcheck"]
USER nonroot
ENTRYPOINT ["/usr/local/bin/pglens-server"]
