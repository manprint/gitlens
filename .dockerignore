# Both Dockerfiles COPY the whole build context and run `make build`, which
# only needs go.mod/go.sum, cmd/, and internal/; the server image's web stage
# also needs web/, api/openapi.yaml, and README.md, which the bundle ships.
# Everything below is irrelevant to those builds and only slows down (or, for
# .git/.serena, potentially leaks into) the build context sent to the
# daemon.
.git/
.github/
.tokensave/
.serena/
.vscode/
.idea/

# Local credentials and environment files
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.crt
*.secret

# Not needed to build the binaries
docs/
!docs/LIMITS.md
!docs/api.md
deploy/
test/
!test/
!test/e2e/
!test/e2e/mockreceiver/
!test/e2e/mockreceiver/**
scripts/
*.md
!README.md

# Build/test byproducts that might exist locally
web/node_modules/
bin/
dist/
# The web build in the host tree is not context, except the placeholder page:
# the agent image embeds the directory and needs an index.html, and the
# server image's web stage replaces the bundle.
internal/webui/dist/*
!internal/webui/dist/index.html
coverage.out
coverage.html
*.prof
*.log
*.test
*.out
workload
pglens-agent
pglens-server

# Lint/editor config, irrelevant inside the image
.golangci.yml
.editorconfig
