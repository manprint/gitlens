# Both Dockerfiles COPY the whole build context and run `make build`, which
# only needs go.mod/go.sum, cmd/, and internal/ — everything below is
# irrelevant to compiling the two binaries and only slows down (or, for
# .git/.serena, potentially leaks into) the build context sent to the
# daemon.
.git/
.github/
.tokensave/
.serena/
.vscode/
.idea/

# Local credentials and environment files
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.crt
*.secret

# Not needed to build the binaries
docs/
deploy/
test/
scripts/
*.md

# Build/test byproducts that might exist locally
bin/
dist/
coverage.out
coverage.html
*.prof
*.log
*.test
*.out
workload
pglens-agent
pglens-server

# Lint/editor config, irrelevant inside the image
.golangci.yml
.editorconfig
