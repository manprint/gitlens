# Copy to /etc/pglens/server.env and replace credentials before starting systemd.

PGLENS_DSN=postgres://pglens:change-me@localhost:5432/pglens?sslmode=disable
PGLENS_LISTEN=:8080
PGLENS_BOOTSTRAP_TOKEN=replace-me
# PGLENS_BOOTSTRAP_TOKEN_FILE=/run/secrets/pglens_token

# The interface is served on the same port as the API. Set PGLENS_UI_PASSWORD
# to a secret; without it the interface is not usable.
# PGLENS_UI_PASSWORD=replace-me
# Optional secret-file alternative to PGLENS_UI_PASSWORD.
# PGLENS_UI_PASSWORD_FILE=/run/secrets/pglens_ui_password
# PGLENS_UI_ENABLED=true
# Session lifetime; accepted range is 5m to 720h (default 24h).
# PGLENS_UI_SESSION_TTL=24h
# Cookie Secure policy: auto, true, or false (default auto).
# PGLENS_UI_COOKIE_SECURE=auto

# Alert evaluator cadence. A bare positive integer is interpreted as seconds.
PGLENS_ALERT_INTERVAL=30s
# Optional Slack notifier. The ALERT-prefixed name is the preferred deployment key.
# PGLENS_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-me
# PGLENS_ALERT_SLACK_WEBHOOK_URL_FILE=/run/secrets/slack_webhook
# Legacy aliases remain accepted: PGLENS_SLACK_WEBHOOK_URL[_FILE].
# PGLENS_WEBHOOK_URL=https://example.invalid/pglens-alerts

# Advisor evaluator cadence; default is 15m.
PGLENS_ADVISOR_INTERVAL=15m
# Queued command lifetime; default is 5m.
PGLENS_COMMAND_TTL=5m

# Storage policies are applied by internal/store/migrations/0003_policies.sql:
# raw metrics retention is 30 days and TimescaleDB compression starts after 48h.
# They are migration constants, not runtime environment variables.
