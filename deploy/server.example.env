# Copy to /etc/pglens/server.env and replace credentials before starting systemd.

PGLENS_DSN=postgres://pglens:change-me@localhost:5432/pglens?sslmode=disable
PGLENS_LISTEN=:8080
PGLENS_BOOTSTRAP_TOKEN=replace-me
# PGLENS_BOOTSTRAP_TOKEN_FILE=/run/secrets/pglens_token

# The interface is served on the same port as the API. Set PGLENS_UI_PASSWORD
# to a secret; without it the interface is not usable.
# PGLENS_UI_PASSWORD=replace-me
# Optional secret-file alternative to PGLENS_UI_PASSWORD.
# PGLENS_UI_PASSWORD_FILE=/run/secrets/pglens_ui_password
# PGLENS_UI_ENABLED=true
# Session lifetime; accepted range is 5m to 720h (default 24h).
# PGLENS_UI_SESSION_TTL=24h
# Cookie Secure policy: auto, true, or false (default auto).
# PGLENS_UI_COOKIE_SECURE=auto

# Alert evaluator cadence. A bare positive integer is interpreted as seconds.
PGLENS_ALERT_INTERVAL=30s
# Optional Slack notifier. The ALERT-prefixed name is the preferred deployment key.
# PGLENS_ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace-me
# PGLENS_ALERT_SLACK_WEBHOOK_URL_FILE=/run/secrets/slack_webhook
# Legacy aliases remain accepted: PGLENS_SLACK_WEBHOOK_URL[_FILE].
# PGLENS_WEBHOOK_URL=https://example.invalid/pglens-alerts
# Optional Google Chat notifier: the incoming webhook of a Chat space. Its
# key and token are secrets; prefer the _FILE form.
# PGLENS_GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/replace-me/messages?key=replace-me&token=replace-me
# PGLENS_GOOGLE_CHAT_WEBHOOK_URL_FILE=/run/secrets/google_chat_webhook
# PGLENS_TEAMS_WEBHOOK_URL=https://replace-me.logic.azure.com/workflows/replace-me/triggers/manual/paths/invoke?sig=replace-me
# PGLENS_TEAMS_WEBHOOK_URL_FILE=/run/secrets/teams_webhook
# PGLENS_PAGERDUTY_ROUTING_KEY_FILE=/run/secrets/pagerduty_routing_key
# Email: recipients are set from Settings > Notifications; the mail server here.
# PGLENS_SMTP_HOST=smtp.example.com
# PGLENS_SMTP_PORT=587
# PGLENS_SMTP_TLS=starttls
# PGLENS_SMTP_FROM=pglens <alerts@example.com>
# PGLENS_SMTP_USERNAME=pglens
# PGLENS_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# Settings > Notifications shows which channels are configured (host only,
# never the URL) and sends a test message. A URL changed here needs a server
# restart. A URL can also be stored from Settings > Notifications, write-only:
# it overrides the value here at once, and removing it there falls back to the
# value here. It is kept unencrypted in the pglens database, so protect the
# database dumps and backups like this file.

# Advisor evaluator cadence; default is 15m.
PGLENS_ADVISOR_INTERVAL=15m
# Queued command lifetime; default is 5m.
PGLENS_COMMAND_TTL=5m

# Storage policies are applied by internal/store/migrations/0003_policies.sql:
# raw metrics retention is 30 days and TimescaleDB compression starts after 48h;
# bloat estimates are kept 90 days (internal/store/migrations/0007_facts.sql).
# The retention of each metrics family can be changed later in Settings >
# Data retention (PUT /api/v1/settings/retention), which rewrites the
# TimescaleDB policy in the database; it is not a runtime environment variable. The 90-day purges of events, unseen query texts,
# resolved alerts (with their deliveries and expired silences) and resolved
# findings stay fixed.
