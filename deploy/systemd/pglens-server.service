[Unit]
Description=pglens analysis server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pglens-server
EnvironmentFile=-/etc/pglens/server.env
DynamicUser=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Neither service needs a capability or a socket family beyond TCP and Unix
# sockets, nor a system call outside the standard service set.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
