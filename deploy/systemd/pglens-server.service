[Unit]
Description=pglens analysis server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pglens-server
EnvironmentFile=-/etc/pglens/server.env
StateDirectory=pglens
DynamicUser=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
