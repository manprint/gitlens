[Unit]
Description=pglens PostgreSQL monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pglens-agent run --config /etc/pglens/agent.yaml
EnvironmentFile=-/etc/pglens/agent.env
StateDirectory=pglens
DynamicUser=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Neither service needs a capability or a socket family beyond TCP and Unix
# sockets, nor a system call outside the standard service set. The one
# exception is AF_NETLINK: Go resolves a named IPv6 zone such as fe80::1%eth0
# through a netlink socket, so that zone does not resolve here. A numeric zone
# such as fe80::1%2 and every global address still work.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
Restart=on-failure
RestartSec=5

# Host metrics need /proc and /sys readable; ProtectSystem=strict protects
# writable system paths and does not prevent read access to these filesystems.

[Install]
WantedBy=multi-user.target
